# PostgreSQL connection string used by the application.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/quran_admin

# Secret used to sign session cookies (JWT).
# Required, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional: only used by `npm run db:role` (scripts/setup-role.mjs) to create or
# rotate the least-privilege application role. Never commit real values.
APP_DB_ROLE=quran_app
APP_DB_PASSWORD=replace-with-a-strong-password-at-least-16-chars

# Optional: used by docker-compose.yml for the bundled PostgreSQL service.
POSTGRES_PASSWORD=replace-with-a-strong-password
